<UserControl x:Class="ScrumPrep.Views.QuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MaxWidth="860" Margin="40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile: Modus, Fortschritt, Timer -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Left" Text="{Binding ModeTitle}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeRemainingText}" FontSize="18"
                       FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                       Visibility="{Binding IsExam, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Frage -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="{StaticResource AccentLightBrush}"
                            CornerRadius="4" Padding="8,3">
                        <TextBlock Text="{Binding CategoryText}" FontSize="12"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding SelectHint}" Style="{StaticResource MutedText}" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding QuestionText}" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Antwortoptionen + Auflösung -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource OptionToggle}"
                                          IsChecked="{Binding IsSelected}"
                                          IsEnabled="{Binding IsEnabled}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                        Visibility="{Binding ShowExplanation, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding FeedbackText}" FontSize="15" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource WrongBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WasAnsweredCorrectly}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource CorrectBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="14"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Fußzeile: Aktionen -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding AnsweredCountText}"
                       Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <!-- Learn/Topic: erst prüfen, dann weiter -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsLearnLike, Converter={StaticResource BoolToVis}}">
                    <Button Content="Check Answer" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding CheckCommand}"
                            Visibility="{Binding IsRevealed, Converter={StaticResource InverseBoolToVis}}"/>
                    <Button Content="Next Question" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding NextCommand}"
                            Visibility="{Binding IsRevealed, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Finish Session" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding FinishCommand}"/>
                </StackPanel>

                <!-- Exam: frei navigieren, am Ende abgeben -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsExam, Converter={StaticResource BoolToVis}}">
                    <Button Content="Previous" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding PreviousCommand}"/>
                    <Button Content="Next" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding NextCommand}"/>
                    <Button Content="Submit Exam" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding SubmitCommand}"/>
                </StackPanel>

                <Button Content="Quit" Style="{StaticResource SecondaryButton}"
                        Command="{Binding QuitCommand}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>

<Application x:Class="ScrumPrep.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ScrumPrep.ViewModels"
             xmlns:views="clr-namespace:ScrumPrep.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#1F6FB2"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#E3F0FA"/>
        <SolidColorBrush x:Key="PageBrush" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="CardBrush" Color="White"/>
        <SolidColorBrush x:Key="BorderGrayBrush" Color="#D0D4DA"/>
        <SolidColorBrush x:Key="TextBrush" Color="#22272E"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6A737D"/>
        <SolidColorBrush x:Key="CorrectBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="CorrectLightBrush" Color="#DCEDC8"/>
        <SolidColorBrush x:Key="WrongBrush" Color="#C62828"/>
        <SolidColorBrush x:Key="WrongLightBrush" Color="#FFCDD2"/>
        <SolidColorBrush x:Key="MissedLightBrush" Color="#FFE0B2"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGrayBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#17547F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#B9C2CB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#5E6B78"/>
        </Style>

        <!-- Antwort-Option: ToggleButton als anklickbare Karte; die Auswertungsfarben
             kommen aus OptionViewModel.State -->
        <Style x:Key="OptionToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource BorderGrayBrush}"
                                BorderThickness="1.5" CornerRadius="6" Padding="14,11" Margin="0,4">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding State}" Value="Correct">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CorrectLightBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CorrectBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="WrongSelected">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WrongLightBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WrongBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Missed">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MissedLightBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#EF6C00"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuizViewModel}">
            <views:QuizView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultViewModel}">
            <views:ResultView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsViewModel}">
            <views:StatsView/>
        </DataTemplate>

    </Application.Resources>
</Application>
